
# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=4000
APP_NAME=sistema-monitoreo-minero

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=monitoreo_db
DB_USER=admin
DB_PASSWORD=changeme

# ============================================
# PGADMIN
# ============================================
PGADMIN_PASSWORD=admin

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# SECURITY - JWT (Autenticación)
# ============================================
# ⚠️ IMPORTANTE: Genera una clave secreta fuerte para producción
# Para generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=desarrollo_jwt_secret_CAMBIAR_EN_PRODUCCION_usar_clave_fuerte_de_64_caracteres
JWT_EXPIRES_IN=24h

# Opciones de expiración:
# - 15m = 15 minutos (recomendado para producción con refresh tokens)
# - 1h = 1 hora
# - 24h = 24 horas (desarrollo)
# - 7d = 7 días

# ============================================
# AWS
# ============================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ============================================
# MONITORING
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
