{
  "name": "sistema-monitoreo-minero",
  "version": "1.0.0",
  "description": "Sistema de monitoreo con Clean Architecture + DDD",
  "main": "app.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node app.ts",
    "dev:simple": "ts-node app.ts",
    "build": "grunt build",
    "start": "npm run build && node dist/app.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "typescript",
    "express",
    "ddd",
    "clean-architecture",
    "mining"
  ],
  "author": "Tu Nombre",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.5",
    "ts-node": "^10.9.0",
    "nodemon": "^3.1.10",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-shell": "^4.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "@types/jest": "^30.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}