{
  "name": "frontend-microservice",
  "version": "1.0.0",
  "description": "Microservicio Frontend del Sistema de Monitoreo Minero",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "npm run build && npm start",
    "test": "echo \"No tests yet\" && exit 0",
    "docker:build": "docker build -t frontend-microservice:latest .",
    "docker:run": "docker run -p 3000:3000 frontend-microservice:latest"
  },
  "keywords": [
    "frontend",
    "microservice",
    "express",
    "typescript",
    "proxy"
  ],
  "author": "Sistema Monitoreo Minero",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
