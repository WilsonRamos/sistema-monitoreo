# ==================================
# Frontend Microservice - Environment Variables
# ==================================

# Puerto del servidor frontend
PORT=3000

# URL del backend (cambiar según el entorno)
# Desarrollo local: http://localhost:4000
# Docker: http://backend:4000
# Producción: https://api.tudominio.com
BACKEND_URL=http://localhost:4000

# Modo de Node
NODE_ENV=development
