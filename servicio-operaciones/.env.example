# ==================================
# Configuración del Microservicio de Operaciones
# ==================================

# Puerto del servicio
PORT=6000

# Entorno (development, production, test)
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/operaciones_db

# CORS
CORS_ORIGIN=http://localhost:3000

# Otros servicios (URLs)
MONITOREO_SERVICE_URL=http://localhost:5000
USUARIOS_SERVICE_URL=http://localhost:7000

# Message Broker (RabbitMQ / Kafka)
RABBITMQ_URL=amqp://localhost:5672
KAFKA_BROKERS=localhost:9092

# Logging
LOG_LEVEL=info
