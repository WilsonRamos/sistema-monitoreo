# ==================================
# Configuración del Microservicio de Monitoreo
# ==================================

# Puerto del servicio
PORT=5000

# Entorno (development, production, test)
NODE_ENV=development

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/monitoreo_db

# CORS
CORS_ORIGIN=http://localhost:3000

# Otros servicios (URLs)
OPERACIONES_SERVICE_URL=http://localhost:6000
USUARIOS_SERVICE_URL=http://localhost:7000

# Message Broker (RabbitMQ / Kafka)
RABBITMQ_URL=amqp://localhost:5672
KAFKA_BROKERS=localhost:9092

# Logging
LOG_LEVEL=info
